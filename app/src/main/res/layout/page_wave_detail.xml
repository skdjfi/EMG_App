<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btnBackD"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_round"
            android:src="@drawable/ic_back"
            android:contentDescription="返回"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="12dp">

            <TextView
                android:id="@+id/dtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CH 1 · 股直肌"
                android:textColor="?attr/textPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.knee.emgapp.view.PulseLedView
                android:id="@+id/dtLive"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginLeft="9dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnThemeD"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_round"
            android:src="@drawable/ic_moon"
            android:contentDescription="切换主题"
            android:padding="9dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnSettingsD"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_round"
            android:src="@drawable/ic_settings"
            android:contentDescription="设置"
            android:padding="9dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 波形面板 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:background="@drawable/bg_card">

        <View
            android:layout_width="240dp"
            android:layout_height="2dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_glow_line"
            android:alpha="0.55" />

        <com.knee.emgapp.view.WaveformView
            android:id="@+id/waveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <TextView
            android:id="@+id/waveTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="10dp"
            android:text="@string/wave_tag"
            android:textColor="?attr/textTertiary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />
    </FrameLayout>

    <!-- 超大数字 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:paddingTop="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rms"
            android:textColor="?attr/textTertiary"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.22"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/stRms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textColor="?attr/textPrimary"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dtPeak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PEAK 0"
            android:textColor="?attr/textSecondary"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:layout_marginBottom="10dp" />
    </LinearLayout>

    <!-- KPI 细条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="@string/mdf"
                android:textColor="?attr/textTertiary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.13" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_track">

                <View
                    android:id="@+id/stMdfM"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_bar_gradient" />
            </FrameLayout>

            <TextView
                android:id="@+id/stMdf"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="0 Hz"
                android:textColor="?attr/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="9dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="@string/quality"
                android:textColor="?attr/textTertiary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.13" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_track">

                <View
                    android:id="@+id/stSnrM"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_bar_gradient" />
            </FrameLayout>

            <TextView
                android:id="@+id/stSnr"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="0%"
                android:textColor="?attr/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 玻璃底栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_glass"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dot0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="CH1"
                android:textColor="@color/white"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_on"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/dot1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginLeft="7dp"
                android:text="CH2"
                android:textColor="?attr/textSecondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/dot2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginLeft="7dp"
                android:text="CH3"
                android:textColor="?attr/textSecondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/dot3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginLeft="7dp"
                android:text="CH4"
                android:textColor="?attr/textSecondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipGain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="×6"
            android:textColor="?attr/textSecondary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/chipSps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="500 Hz"
            android:textColor="?attr/textSecondary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>