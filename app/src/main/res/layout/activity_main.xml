<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bg">

    <!-- ===== 主页(波形) ===== -->
    <include
        layout="@layout/page_wave"
        android:id="@+id/pageWave" />

    <!-- ===== 预测页 ===== -->
    <include
        layout="@layout/page_predict"
        android:id="@+id/pagePredict"
        android:visibility="gone" />

    <!-- ===== 底部玻璃 Tab 栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass"
            android:elevation="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tabWave"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_wave"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="?attr/accent"
                android:drawableTop="@drawable/ic_wave"
                android:drawablePadding="2dp"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="58dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tabPredict"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_predict"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="?attr/textTertiary"
                android:drawableTop="@drawable/ic_predict"
                android:drawablePadding="2dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 中间凸起 FAB(启动/停止) ===== -->
    <ImageButton
        android:id="@+id/fab"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bg_btn_accent"
        android:elevation="12dp"
        android:src="@drawable/ic_play"
        android:contentDescription="启动/停止采集"
        android:scaleType="centerInside"
        android:padding="16dp" />

    <!-- ===== 波形详情(全屏覆盖) ===== -->
    <include
        layout="@layout/page_wave_detail"
        android:id="@+id/pageWaveDetail"
        android:visibility="gone" />

    <!-- ===== IMU 详情(全屏覆盖) ===== -->
    <include
        layout="@layout/page_imu_detail"
        android:id="@+id/pageImuDetail"
        android:visibility="gone" />

</FrameLayout>