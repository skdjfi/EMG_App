<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ===== 连接区 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="@string/host_hint"
                android:inputType="text"
                android:maxLines="1"
                android:text="192.168.4.1" />

            <EditText
                android:id="@+id/editPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/port_hint"
                android:inputType="number"
                android:maxLines="1"
                android:text="5000" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/status_disconnected"
            android:textColor="@color/chart2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_text"
            android:textSize="12sp" />

        <!-- ===== 肌电波形 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="4 通道肌电 (EMG)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartCh1"
            android:layout_width="match_parent"
            android:layout_height="160dp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartCh2"
            android:layout_width="match_parent"
            android:layout_height="160dp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartCh3"
            android:layout_width="match_parent"
            android:layout_height="160dp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartCh4"
            android:layout_width="match_parent"
            android:layout_height="160dp" />

        <!-- ===== IMU 数据 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="IMU 姿态数据"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtImu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACC: -  GYR: -"
            android:textSize="12sp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartImu"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <!-- ===== 命令区 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="控制命令"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cmd_start" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cmd_stop" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGainMinus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-增益" />

            <Button
                android:id="@+id/btnGainPlus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+增益" />

            <Button
                android:id="@+id/btnSpsMinus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-采样" />

            <Button
                android:id="@+id/btnSpsPlus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+采样" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnImuOn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cmd_imu_on" />

            <Button
                android:id="@+id/btnImuOff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cmd_imu_off" />

            <Button
                android:id="@+id/btnGetInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cmd_get_info" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>