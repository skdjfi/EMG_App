<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="96dp">

        <!-- ===== 顶栏 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_logo"
                android:src="@drawable/ic_logo"
                android:contentDescription="logo"
                android:padding="9dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="11dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="?attr/textPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_sub"
                    android:textColor="?attr/textSecondary"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnTheme"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_round"
                android:src="@drawable/ic_moon"
                android:contentDescription="切换主题"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_round"
                android:src="@drawable/ic_settings"
                android:contentDescription="设置"
                android:padding="9dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- ===== 状态卡 ===== -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="15dp"
            android:layout_marginBottom="18dp">

            <View
                android:layout_width="3dp"
                android:layout_height="64dp"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="10dp"
                android:background="@drawable/bg_status_edge" />

            <com.knee.emgapp.view.PulseLedView
                android:id="@+id/ledStatus"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginTop="3dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESP32 网关"
                        android:textColor="?attr/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/stMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:text="@string/status_ap"
                        android:textColor="?attr/accent"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="7dp"
                        android:paddingRight="7dp"
                        android:paddingTop="2.5dp"
                        android:paddingBottom="2.5dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/stHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.4.1:5000 · 未连接"
                    android:textColor="?attr/textSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="增益 "
                        android:textColor="?attr/textSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="9dp"
                        android:paddingRight="4dp"
                        android:paddingTop="3.5dp"
                        android:paddingBottom="3.5dp" />

                    <TextView
                        android:id="@+id/bGain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="×6"
                        android:textColor="?attr/accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="4dp"
                        android:paddingRight="9dp"
                        android:paddingTop="3.5dp"
                        android:paddingBottom="3.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="采样 "
                        android:textColor="?attr/textSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="9dp"
                        android:paddingRight="4dp"
                        android:paddingTop="3.5dp"
                        android:paddingBottom="3.5dp" />

                    <TextView
                        android:id="@+id/bSps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500 SPS"
                        android:textColor="?attr/accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="4dp"
                        android:paddingRight="9dp"
                        android:paddingTop="3.5dp"
                        android:paddingBottom="3.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="IMU "
                        android:textColor="?attr/textSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="9dp"
                        android:paddingRight="4dp"
                        android:paddingTop="3.5dp"
                        android:paddingBottom="3.5dp" />

                    <TextView
                        android:id="@+id/bImu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/imu_badge"
                        android:textColor="?attr/accent"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip"
                        android:paddingLeft="4dp"
                        android:paddingRight="9dp"
                        android:paddingTop="3.5dp"
                        android:paddingBottom="3.5dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnConn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/connect"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_accent"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- ===== 区标题 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_marginBottom="13dp">

            <View
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:background="?attr/accent"
                android:layout_marginRight="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chan_section"
                android:textColor="?attr/textSecondary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <!-- ===== 通道 2x2 网格 ===== -->
