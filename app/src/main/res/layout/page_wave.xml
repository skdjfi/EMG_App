                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="center"
                            android:background="?attr/ch1" />
                    </FrameLayout>
                </LinearLayout>

                <com.knee.emgapp.view.MiniWaveView
                    android:id="@+id/miniW0"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/chVal0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textColor="?attr/textPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/uv_unit"
                        android:textColor="?attr/textTertiary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp" />

                    <View
                        android:id="@+id/liveDot0"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="?attr/ch1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chName0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ch_name_0"
                        android:textColor="?attr/textTertiary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/textSecondary"
                        android:textSize="14sp" />
                </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/chCard1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="6.5dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/chHalo1"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-34dp"
                    android:layout_marginRight="-34dp"
                    android:background="@drawable/bg_halo"
                    android:alpha="0.28" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chLabel1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CH 2"
                        android:textColor="?attr/textSecondary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.22" />

                    <FrameLayout
                        android:layout_width="18dp"
                        android:layout_height="18dp">

                        <View
                            android:id="@+id/chDotGlow1"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_halo" />

                        <View
                            android:id="@+id/chDot1"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="center"
                            android:background="?attr/ch2" />
                    </FrameLayout>
                </LinearLayout>

                <com.knee.emgapp.view.MiniWaveView
                    android:id="@+id/miniW1"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/chVal1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textColor="?attr/textPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/uv_unit"
                        android:textColor="?attr/textTertiary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp" />

                    <View
                        android:id="@+id/liveDot1"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="?attr/ch2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chName1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ch_name_1"
                        android:textColor="?attr/textTertiary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/textSecondary"
                        android:textSize="14sp" />
                </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="13dp">

            <FrameLayout
                android:id="@+id/chCard2"
