                        android:text="@string/ch_name_3"
                        android:textColor="?attr/textTertiary"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/textSecondary"
                        android:textSize="14sp" />
                </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ===== IMU 卡(可点击) ===== -->
        <LinearLayout
            android:id="@+id/imuCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_round"
                    android:src="@drawable/ic_imu"
                    android:contentDescription="IMU"
                    android:padding="11dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="13dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/imu_name"
                            android:textColor="?attr/textPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="7dp"
                            android:text="@string/imu_chip"
                            android:textColor="?attr/accent"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_chip"
                            android:paddingLeft="7dp"
                            android:paddingRight="7dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/imuTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ACC 0.00 · 0.00 · 0.00 g　GYR 0 · 0 · 0 °/s"
                        android:textColor="?attr/textSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="?attr/textSecondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="4.5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROLL"
                        android:textColor="?attr/textTertiary"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_track">

                        <View
                            android:id="@+id/barR"
                            android:layout_width="38dp"
                            android:layout_height="match_parent"
                            android:background="?attr/accent" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="4.5dp"
                    android:layout_marginRight="4.5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PITCH"
                        android:textColor="?attr/textTertiary"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_track">

                        <View
                            android:id="@+id/barP"
                            android:layout_width="55dp"
                            android:layout_height="match_parent"
                            android:background="?attr/danger" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="4.5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YAW"
                        android:textColor="?attr/textTertiary"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_track">

                        <View
                            android:id="@+id/barY"
                            android:layout_width="22dp"
                            android:layout_height="match_parent"
                            android:background="?attr/warn" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>